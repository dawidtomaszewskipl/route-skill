        "required": ["section", "claim_in_plan", "problem", "evidence", "fix"],
        "properties": {
          "section": { "type": "string" },
          "claim_in_plan": { "type": "string" },
          "problem": { "type": "string" },
          "evidence": { "type": "string" },
          "fix": { "type": "string" }
